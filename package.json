{
  "name": "currency-codes",
  "version": "2.2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "description": "Lookup currency codes based on ISO 4217",
  "repository": "git://github.com/freeall/currency-codes.git",
  "keywords": [
    "iso4217",
    "iso",
    "4217",
    "currency",
    "currencies",
    "code",
    "codes",
    "lookup"
  ],
  "devDependencies": {
    "@gouch/to-title-case": "^2.2.1",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^5.0.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:ui": "npm run build && vitest --ui",
    "test:performance": "npm run build && vitest run ingest.performance.test.ts",
    "test:esm": "npm run build && node --input-type=module test/esm.test.js",
    "test:cjs": "npm run build && node test/cjs.test.js",
    "iso:fetch-xml": "tsx scripts/iso-4217/fetch.ts",
    "iso:ingest-xml": "tsx scripts/iso-4217/ingest.ts",
    "iso": "npm run iso:fetch-xml && npm run iso:ingest-xml"
  },
  "license": "MIT"
}
